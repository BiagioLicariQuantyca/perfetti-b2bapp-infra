<policies>
  <!--
    Global policy (all APIs of the instance). Generated by Terraform from this template: do not
    edit it in the portal, changes would be overwritten at the next apply.
    - inbound: bearer token validation for every API, so that no API is ever published without
      authentication; when no validation is configured, every request is rejected with 401.
      The validated token is stored in the "jwt" context variable for API-level checks.
    - backend: concurrency limit per API and timeout towards the backend.
    The global scope has no parent, so it contains no <base /> element.
  -->
  <inbound>
%{ if jwt == null ~}
    <return-response>
      <set-status code="401" reason="Unauthorized" />
      <set-header name="WWW-Authenticate" exists-action="override">
        <value>Bearer</value>
      </set-header>
    </return-response>
%{ else ~}
    <validate-jwt header-name="Authorization" require-scheme="Bearer" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized" require-expiration-time="true" require-signed-tokens="true" output-token-variable-name="jwt">
%{ if jwt.openid_config_url != null ~}
      <openid-config url="${jwt.openid_config_url}" />
%{ endif ~}
%{ if length(jwt.signing_keys) > 0 ~}
      <issuer-signing-keys>
%{ for key in jwt.signing_keys ~}
        <key id="${key.id}" n="${key.n}" e="${key.e}" />
%{ endfor ~}
      </issuer-signing-keys>
%{ endif ~}
      <audiences>
%{ for audience in jwt.audiences ~}
        <audience>${audience}</audience>
%{ endfor ~}
      </audiences>
%{ if length(jwt.issuers) > 0 ~}
      <issuers>
%{ for issuer in jwt.issuers ~}
        <issuer>${issuer}</issuer>
%{ endfor ~}
      </issuers>
%{ endif ~}
%{ if length(jwt.required_claims) > 0 ~}
      <required-claims>
%{ for claim in jwt.required_claims ~}
        <claim name="${claim.name}" match="${claim.match}"%{ if claim.separator != null } separator="${claim.separator}"%{ endif }>
%{ for value in claim.values ~}
          <value>${value}</value>
%{ endfor ~}
        </claim>
%{ endfor ~}
      </required-claims>
%{ endif ~}
    </validate-jwt>
%{ endif ~}
  </inbound>
  <backend>
    <limit-concurrency key="@(context.Api.Id)" max-count="${max_concurrency}">
      <forward-request timeout="${backend_timeout_seconds}" />
    </limit-concurrency>
  </backend>
  <outbound />
  <on-error />
</policies>
