<policies>
  <!--
    API policy of the B2B API. Generated by Terraform from this template: do not edit it in
    the portal, changes would be overwritten at the next apply.
    - inbound: bearer token validation (closed by default when no validation is configured),
      then routing to the Function App backend;
    - backend: concurrency limit towards the Function App (excess requests receive 429).
  -->
  <inbound>
    <base />
%{ if jwt == null ~}
    <return-response>
      <set-status code="401" reason="Unauthorized" />
      <set-header name="WWW-Authenticate" exists-action="override">
        <value>Bearer</value>
      </set-header>
    </return-response>
%{ else ~}
    <validate-jwt header-name="Authorization" require-scheme="Bearer" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized" require-expiration-time="true" require-signed-tokens="true">
%{ if jwt.openid_config_url != null ~}
      <openid-config url="${jwt.openid_config_url}" />
%{ endif ~}
%{ if length(jwt.signing_keys) > 0 ~}
      <issuer-signing-keys>
%{ for key in jwt.signing_keys ~}
        <key id="${key.id}" n="${key.n}" e="${key.e}" />
%{ endfor ~}
      </issuer-signing-keys>
%{ endif ~}
      <audiences>
%{ for audience in jwt.audiences ~}
        <audience>${audience}</audience>
%{ endfor ~}
      </audiences>
%{ if length(jwt.issuers) > 0 ~}
      <issuers>
%{ for issuer in jwt.issuers ~}
        <issuer>${issuer}</issuer>
%{ endfor ~}
      </issuers>
%{ endif ~}
%{ if length(jwt.required_claims) > 0 ~}
      <required-claims>
%{ for claim in jwt.required_claims ~}
        <claim name="${claim.name}" match="${claim.match}"%{ if claim.separator != null } separator="${claim.separator}"%{ endif }>
%{ for value in claim.values ~}
          <value>${value}</value>
%{ endfor ~}
        </claim>
%{ endfor ~}
      </required-claims>
%{ endif ~}
    </validate-jwt>
%{ endif ~}
    <set-backend-service backend-id="${backend_id}" />
  </inbound>
  <backend>
    <limit-concurrency key="${backend_id}" max-count="${max_concurrency}">
      <forward-request />
    </limit-concurrency>
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
